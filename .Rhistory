unique()
MR_score_reinoc_comp_meta_keepescape$Drought_sev <- gsub("Mid", "Moderate",MR_score_reinoc_comp_meta_keepescape$Drought_sev)
MR_score_reinoc_comp_meta_keepescape$Drought_sev <- factor(MR_score_reinoc_comp_meta_keepescape$Drought_sev, levels = c("Low", "Moderate", "High"))
# Visualisation
