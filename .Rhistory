library(lubridate)
season_rects <- reg_monit_survey_results %>%
mutate(
Year = year(Date),
Month = month(Date),
Season = case_when(
Month %in% c(12, 1, 2) ~ "Summer",
Month %in% c(3, 4, 5) ~ "Autumn",
Month %in% c(6, 7, 8) ~ "Winter",
Month %in% c(9, 10, 11) ~ "Spring"
),
Season_Year = if_else(Month == 12, Year + 1, Year)
) %>%
mutate(
season_start = case_when(
Season == "Summer" ~ as.Date(paste0(Season_Year - 1, "-12-01")),
Season == "Autumn" ~ as.Date(paste0(Season_Year, "-03-01")),
Season == "Winter" ~ as.Date(paste0(Season_Year, "-06-01")),
Season == "Spring" ~ as.Date(paste0(Season_Year, "-09-01"))
),
season_end = case_when(
Season == "Summer" ~ as.Date(paste0(Season_Year, "-02-", days_in_month(2))),
Season == "Autumn" ~ as.Date(paste0(Season_Year, "-05-", days_in_month(5))),
Season == "Winter" ~ as.Date(paste0(Season_Year, "-08-", days_in_month(8))),
Season == "Spring" ~ as.Date(paste0(Season_Year, "-11-", days_in_month(11)))
)
) %>%
dplyr::select(Year, Month, Season, season_start, season_end)
season_rects <- unique(season_rects %>% dplyr::select(season_start, season_end, Season))
reg_monit_survey_results$Season <- case_when(
as.numeric(reg_monit_survey_results$Month) %in% c(12, 1, 2) ~ "Summer",
as.numeric(reg_monit_survey_results$Month) %in% c(3, 4, 5) ~ "Autumn",
as.numeric(reg_monit_survey_results$Month) %in% c(6, 7, 8) ~ "Winter",
as.numeric(reg_monit_survey_results$Month) %in% c(9, 10, 11) ~ "Spring"
)
bin_monit_survey_results$Season <- case_when(
as.numeric(bin_monit_survey_results$Month) %in% c(12, 1, 2) ~ "Summer",
as.numeric(bin_monit_survey_results$Month) %in% c(3, 4, 5) ~ "Autumn",
as.numeric(bin_monit_survey_results$Month) %in% c(6, 7, 8) ~ "Winter",
as.numeric(bin_monit_survey_results$Month) %in% c(9, 10, 11) ~ "Spring"
)
min_year <- min(reg_monit_survey_results$Year, na.rm=T)
Date_index_tbl <- reg_monit_survey_results %>%
arrange(Date) %>%
mutate(
# Calculates months passed from the baseline year, then adds the current month
Date_index = (Year - min_year) * 12 + Month
) %>%
dplyr::select(Date, Year, Month, Date_index) %>%
distinct()
# Add in date number index
reg_monit_survey_results <- left_join(reg_monit_survey_results, Date_index_tbl)
bin_monit_survey_results <- left_join(bin_monit_survey_results, Date_index_tbl)
# Add in date number index for season rects
lookup <- Date_index_tbl %>%
dplyr::select(Year, Month, Date_index) %>%
distinct(Year, Month, .keep_all = TRUE)
season_rects <- season_rects %>%
mutate(Year_start = year(season_start) - 2000, Month_start = month(season_start)) %>% # Matching the '25' format
left_join(lookup, by = c("Year_start" = "Year", "Month_start" = "Month")) %>%
rename(Date_index_start = Date_index)
season_rects <- season_rects %>%
mutate(Year_end = year(season_end) - 2000, Month_end = month(season_end)) %>%
left_join(lookup, by = c("Year_end" = "Year", "Month_end" = "Month")) %>%
rename(Date_index_end = Date_index)
season_rects <- season_rects %>%
dplyr::select(-Year_start, -Year_end)
season_rects[which(is.na(season_rects$Date_index_end)), "Date_index_end"] = season_rects[which(is.na(season_rects$Date_index_end)), "Date_index_start"] + 3
season_rects$Date_index_start_amend <- season_rects$Date_index_start-1
reg_monit_survey_results$`Myrtle rust impact score`[reg_monit_survey_results$`Myrtle rust impact score` == 0.5] = 0
reg_monit_survey_results$`Myrtle rust worst score`[reg_monit_survey_results$`Myrtle rust worst score` == 0.5] = 0
# Augment binary res
bin_sub <- bin_monit_survey_results %>%
dplyr::select(Index, Site, Subsite, UID, UID_numb, Date, Surveyor, `Height (m)`, `Binary Score`, Month, Year, Season) %>%
mutate(Set = "Raw")
reg_bin_conv <- reg_monit_survey_results %>%
mutate(`Binary Score` = ifelse(`Myrtle rust worst score` >= 2, 1, 0),
Set = "Augmented") %>%
dplyr::select(Index, Site, Subsite, UID, UID_numb, Date, Surveyor, `Height (m)`, `Binary Score`, Month, Year, Season, Set) %>%
anti_join(bin_sub, by = c("UID", "Site", "Date"))
bin_monit_survey_results_aug <- as.data.frame(rbind(reg_bin_conv, bin_sub)) %>%
filter(!is.na(`Binary Score`))
bin_monit_survey_results_aug <- left_join(bin_monit_survey_results_aug, Date_index_tbl)
## Most recent
recent_survey <- max(reg_monit_survey_results$Date_index)
survey_results_recents <- reg_monit_survey_results %>%
filter(Date_index==Date_index)
## Create UID summarys
UID_sum_AS <- reg_monit_survey_results %>%
group_by(UID_numb, Site) %>%
summarise (Measurements = n(),
AS_Observed = case_when(
any(`Active sporulation` == "Y") ~ "Yes",
any(`Active sporulation` == "N") ~ "No"
))
