dplyr::select(Mat_line_Sitecoll, Maternal_line, Predicted_Mat_Prediction, n) %>%
unique()
Mat_line_site_uniq %>%
group_by(Mat_line_Sitecoll) %>%
summarise(n=n())
Mat_line_info_plot <- ggplot() +
geom_boxplot( data= Mat_line_site_uniq, aes(x=Mat_line_Sitecoll, y=Predicted_Mat_Prediction)) +
geom_jitter(width=0.1, alpha=0.5, data= Mat_line_site_uniq, aes(x=Mat_line_Sitecoll, y=Predicted_Mat_Prediction, colour=n)) +
scale_colour_viridis_c() +
scale_x_discrete(labels = c("Cattai wetlands", "Hunter Wetlands Centre", "Myall Lakes NP")) +
