# reg_monit_survey_results_mat_GT$Impact_pred_diff <- scales::rescale(as.numeric(reg_monit_survey_results_mat_GT$`Myrtle rust impact score`), from = c(0,5), to = c(0,3)) - reg_monit_survey_results_mat_GT$Prediction
# reg_monit_survey_results_mat_GT$Worst_pred_diff <- scales::rescale(as.numeric(reg_monit_survey_results_mat_GT$`Myrtle rust worst score`), from = c(0,5), to = c(0,3)) - reg_monit_survey_results_mat_GT$Prediction
