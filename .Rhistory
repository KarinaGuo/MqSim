# Libraries
library(tidyverse); library(readxl); library(patchwork); library(lme4); library(lmerTest); library(ozmaps); library(tidyterra); library(terra)
# Meta data
IID_block <- read_xlsx(path="FID Selection & ID & Randomisation_vers1.xlsx", sheet = 'real_IID_Block_Cell_12tray')
IID_block_sub <- IID_block %>%
select(IID, Mat_Line, Drought_sev, Drought_len, block_cell1, Status)
IID_block_sub$block_cell1 <- as.character(IID_block_sub$block_cell1)
# Maternal line data
parent_meta <- read.csv ("parent_meta.csv")
parent_meta_lib <- parent_meta %>%
dplyr::select(NSWID, sample_lib_NSW)
### Adding in meanCOI each maternal line
mquin_meta <- read.csv(file="~/RBGSyd_Technical Officer/MQuin/Processing Meta/Mquin_samples_pheno.csv")
Mat_meta <- mquin_meta %>% group_by(FID) %>% summarise(mean_COI=mean(COI, na.rm=T))
colnames(Mat_meta) <- c("Mat_Line", "mean_COI")
# Height-weight data
height_weight_data <- read.csv(file = "Height_weight_track.csv")
height_weight_data$Date <- as.Date(height_weight_data$Date, format = "%d/%m/%Y")
height_weight_data$Height..mm. <- as.numeric(height_weight_data$Height..mm.)
height_weight_data <- left_join(height_weight_data, IID_block)
height_weight_data_rmna <- height_weight_data %>%
filter(!is.na(Height..mm.))
Exp_Mat_Line <- unique(IID_block$Mat_Line)
parent_meta_rel <- parent_meta %>% filter (NSWID %in% Exp_Mat_Line); colnames(parent_meta_rel)[2] <- "Mat_Line"
parent_meta_rel <- left_join(parent_meta_rel, Mat_meta)
# worldclim_country("Australia", var="prec", path="~/Delete", res=0.5)
mnth_avg_prec <- raster::stack("~/Uni/Doctorate/Ch Planting/data/AUS_wc2.1_30s_prec.tif")
clim_res=NULL
for (i in 1:nrow(parent_meta_rel)){
site=parent_meta_rel[i, "Pop"]
lat=as.numeric(parent_meta_rel[i, "latitude"]); long=as.numeric(parent_meta_rel[i, "longitude"])
prec = sum(raster::extract(mnth_avg_prec, cbind(long, lat)))
clim_res <- as.data.frame(rbind(clim_res, cbind(Pop=site, longitude=as.numeric(long), latitude=as.numeric(lat), prec=prec)))
}
remove(mnth_avg_prec)
clim_res$longitude <- as.numeric(clim_res$longitude); clim_res$latitude <- as.numeric(clim_res$latitude)
parent_meta_rel <- unique(left_join(parent_meta_rel, clim_res)); parent_meta_rel$prec <- as.numeric(parent_meta_rel$prec)
IID_block <- left_join(IID_block, parent_meta_rel %>% dplyr::select(Mat_Line, mean_COI, longitude, latitude))
