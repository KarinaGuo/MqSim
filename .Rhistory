MR_score_GT_pred$IID <- as.numeric(MR_score_GT_pred$IID); MR_score_GT_pred$Drought_len <- as.numeric(MR_score_GT_pred$Drought_len)
base_dir="~/Uni/Doctorate/Samples/Genotyping/Report-DMela25-10753/Report-DMela25-10753/"
prediction_gt <- read.csv(paste0(base_dir, "GP_Out_rmclimsnps/Nohomo/prediction_gt.csv")) %>% dplyr::select(c(Taxa, PEV, Prediction))
colnames(prediction_gt)[1] <- "NSWID"
sample_meta_drought <- read_xlsx("~/Uni/Doctorate/Samples/All_samples.xlsx") %>% filter(!is.na(NSWID) & `Genotyping Purpose`=="Drought_experiment") %>% dplyr::select(NSWID, Drought_Exp_ID)
prediction_gt_droughtexp <- inner_join(prediction_gt, sample_meta_drought, by="NSWID")
## Removing low reliability predictions
prediction_gt_droughtexp_poorsamp <- prediction_gt_droughtexp %>% filter(PEV > 0.5)
prediction_gt_droughtexp <- prediction_gt_droughtexp %>% filter(PEV < 0.5)
cat(nrow(prediction_gt_droughtexp_poorsamp), "samples removed by PEV \n")
colnames(prediction_gt_droughtexp)[4] <- "IID"; prediction_gt_droughtexp$IID <- as.numeric(prediction_gt_droughtexp$IID )
colnames(prediction_gt_droughtexp)[3] <- "Prediction_IID"
## Merging with scoring data
MR_score_GT_pred <- left_join(prediction_gt_droughtexp, MR_score_IID, by="IID")
MR_score_pred_GT <- left_join(MR_score_IID, prediction_gt_droughtexp, by="IID")
