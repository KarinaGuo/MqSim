# Meta data
prediction_gt_plantingexp <- read_xlsx("~/Uni/Doctorate/Ch Planting/data/IIDs.xlsx", sheet="MatLine_Info") %>% filter (Predicted_Mat_Notes == "Using GAPIT_26")
prediction_gt_plantingexp <- prediction_gt_plantingexp[, c("Auxillary Text", "Predicted_Mat_PEV", "Predicted_Mat_value")]
colnames(prediction_gt_plantingexp) <- c("Maternal_line", "Predicted_Mat_PEV", "Predicted_Mat_Prediction")
prediction_gt_planted_mat  <- prediction_gt_planted[, c("NSWID", "PEV", "Prediction")]; colnames(prediction_gt_planted_mat) <- c("Maternal_line", "Predicted_Mat_PEV", "Predicted_Mat_Prediction")
prediction_gt_planted_fin <- data.frame(unique(rbind(prediction_gt_plantingexp, prediction_gt_planted_mat)))
Maternal_line_info <- left_join(planted_indivs_meta, prediction_gt_planted_fin, by= "Maternal_line")
Maternal_line_info <- Maternal_line_info %>%
filter(!is.na(Maternal_line)) %>%
dplyr::select(UID, Maternal_line, Mat_line_Sitecoll, Predicted_Mat_Prediction, Predicted_Mat_PEV)
mat_line_seedlplant <- Maternal_line_info %>%
group_by(Maternal_line) %>%
summarise(n=n()) %>%
ungroup()
Maternal_line_info <- left_join(Maternal_line_info, mat_line_seedlplant)
