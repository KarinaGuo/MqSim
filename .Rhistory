#geom_point(data = MR_score_reinoc_comp_meta_keepescape, aes(x=COI_Scores_Inoc1^0.25, y=COI_Scores_Inoc2^0.25, colour = Difference), alpha=0.5) +
geom_point(data = MR_score_reinoc_comp_meta, aes(x=COI_Scores_Inoc1^0.25, y=COI_Scores_Inoc2^0.25, colour = Difference), alpha=0.5) +
theme_bw () +
geom_abline(intercept=0, slope=1, colour="grey", linetype="dashed") +
facet_wrap (~Drought_len * Drought_sev) +
labs (x=expression(paste("Droughted score (COI)")^0.25), y=expression(paste("Water replete score (COI)")^0.25), colour = paste("Difference \n(untransformed COI)"))
