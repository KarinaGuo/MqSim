prediction_gt_2 <- read.csv("~/Uni/Doctorate/Samples/Genotyping/Report-DMela25-10229/Report_DMela25-10229_RegularGenotyping/GP_Out_rmclimsnps/Nohomo/prediction_gt.csv") %>% dplyr::select(c(Taxa, PEV, Prediction))
prediction_gt_3 <- read.csv("~/Uni/Doctorate/Samples/Genotyping/Report-DMela26-11510/GP_Out_rmclimsnps/Nohomo/prediction_gt.csv") %>% dplyr::select(c(Taxa, PEV, Prediction))
prediction_gt_4 <- read.csv("~/Uni/Doctorate/Samples/Genotyping/Report-DMela26-11752/GP_Out_rmclimsnps/Nohomo/prediction_gt_planting.csv") %>% dplyr::select(c(UID, PEV, Prediction)); prediction_gt_4$UID <- gsub("Mq_", "", prediction_gt_4$UID); colnames(prediction_gt_4)[1] <- "Taxa"
