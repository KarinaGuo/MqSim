### Detailed - Worst
reg_monit_survey_results_mat_GT$`Myrtle rust worst score` <-
factor(reg_monit_survey_results_mat_GT$`Myrtle rust worst score`,
levels = 0:5,
ordered = TRUE)
reg_monit_survey_results_mat_GT$Date_index <-
factor(reg_monit_survey_results_mat_GT$Date_index,
sort(unique(reg_monit_survey_results_mat_GT$Date_index)),
ordered = TRUE)
mod_worst <- clmm(`Myrtle rust worst score` ~ Date_index+ Site + (1 | UID), data = reg_monit_survey_results_mat_GT, link = "logit")
# latent deviation for each UID,
ranef_scores <- ranef(mod_worst)$UID; ranef_scores<- rownames_to_column(ranef_scores, var="UID"); colnames(ranef_scores)[2] <- "ranef_int" # random intercepts
Worst_BLUP <- ranef_scores %>% dplyr::select(ranef_int, UID)
colnames(Worst_BLUP)[1] <- "Worst_MR_BLUP"
reg_monit_survey_results_mat_GT_summ <- left_join(reg_monit_survey_results_mat_GT, Worst_BLUP, by="UID")
### Detailed - impact
reg_monit_survey_results_mat_GT$`Myrtle rust impact score` <-
factor(reg_monit_survey_results_mat_GT$`Myrtle rust impact score`,
levels = 0:5,
ordered = TRUE)
mod_impact <- clmm(`Myrtle rust impact score` ~ Date_index + Site  + (1 | UID), data = reg_monit_survey_results_mat_GT, link = "logit")
# latent deviation for each UID,
ranef_scores <- ranef(mod_impact)$UID; ranef_scores<- rownames_to_column(ranef_scores, var="UID"); colnames(ranef_scores)[2] <- "ranef_int" # random intercepts
Impact_BLUP <- ranef_scores %>% dplyr::select(ranef_int, UID)
colnames(Impact_BLUP)[1] <- "Impact_MR_BLUP"
reg_monit_survey_results_mat_GT_summ <- left_join(reg_monit_survey_results_mat_GT_summ, Impact_BLUP, by="UID")
# Maternal info
reg_monit_survey_results_mat_GT_summ <- left_join(reg_monit_survey_results_mat_GT_summ, Maternal_line_info)
reg_rm_snapped <- reg_monit_survey_results_mat_GT_summ %>% filter(!(UID_numb %in% survey_results_snapped_indv$UID_numb))
reg_monit_survey_results_mat_GT_summ$`Myrtle rust worst score` <- as.numeric(as.character(reg_monit_survey_results_mat_GT_summ$`Myrtle rust worst score`))
## Extra
reg_monit_survey_results_mat_GT_summ <- reg_monit_survey_results_mat_GT_summ %>%
group_by(UID) %>%
mutate(AS_hist = ifelse(any(`Active sporulation` == "Y"), "AS observed", "AS not observed")) %>%
ungroup()
#############################
#### Binary
bin_monit_survey_results_mat_GT$Date_index <-
factor(bin_monit_survey_results_mat_GT$Date_index,
sort(unique(bin_monit_survey_results_mat_GT$Date_index)),
ordered = TRUE)
#  Model failed to converge with max|grad| = 0.483456 (tol = 0.002, component 1)
mod_bin <- glmer(`Binary Score` ~ Date_index + Site + (1 | UID), family = binomial, data = bin_monit_survey_results_mat_GT)
# latent deviation for each UID
ranef_scores <- ranef(mod_bin)$UID; ranef_scores<- rownames_to_column(ranef_scores, var="UID"); colnames(ranef_scores)[2] <- "ranef_int" # random intercepts
#individual_effects <- coef(mod)$UID; individual_effects<- rownames_to_column(individual_effects, var="UID") # population adjusted BLUPs; global mean + ranef_int.
BS_BLUP <- ranef_scores %>% dplyr::select(ranef_int, UID)
colnames(BS_BLUP)[1] <- "BS_MR_BLUP"
bin_monit_survey_results_mat_GT_summ <- left_join(bin_monit_survey_results_mat_GT, BS_BLUP, by="UID")
# Maternal info
bin_monit_survey_results_mat_GT_summ <- left_join(bin_monit_survey_results_mat_GT_summ, Maternal_line_info, by ="UID")
sampled_uids <- sample(unique(reg_monit_survey_results_mat_GT_summ$UID), 10)
tmp_1 <- reg_monit_survey_results_mat_GT_summ %>% filter(UID %in% sampled_uids)
tmp_2 <- bin_monit_survey_results_mat_GT_summ %>% filter(UID %in% sampled_uids)
sampled_uids <- sample(unique(reg_monit_survey_results_mat_GT_summ$UID), 50)
tmp_1 <- reg_monit_survey_results_mat_GT_summ %>% filter(UID %in% sampled_uids)
tmp_2 <- bin_monit_survey_results_mat_GT_summ %>% filter(UID %in% sampled_uids)
tmp_2 <- bin_monit_survey_results_mat_GT_summ %>% filter(UID %in% sampled_uids); write.csv(tmp_1, file = "~/Delete/MR_planting_binary_individuals.csv")
tmp_1 <- reg_monit_survey_results_mat_GT_summ %>% filter(UID %in% sampled_uids); write.csv(tmp_1, file = "~/Delete/MR_planting_detailed_individuals.csv")
